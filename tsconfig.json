{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "nutree-blog-source": ["./src/lib/blog-source.ts"],
      "nutree-blog-render": ["./src/lib/blog-render.ts"]
    }
  },
  "include": ["next-env.d.ts", "src/nutree-blog-files.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".cloudflare/types/**/*.ts"],
  "exclude": ["node_modules"]
}
