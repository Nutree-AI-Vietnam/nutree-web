# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Optional: For error tracking sourcemaps
POSTHOG_PERSONAL_API_KEY=your_personal_api_key
POSTHOG_ENV_ID=your_environment_id

# TikTok Events API (server-only; never prefix the token with NEXT_PUBLIC_)
TIKTOK_EVENTS_ACCESS_TOKEN=your_tiktok_events_api_access_token
TIKTOK_PIXEL_ID=your_tiktok_pixel_id

# MealTrack Admin: SIT/PROD switcher uses the server proxy.
# The Firebase web API key is client-visible configuration, not a service-account secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_MEALTRACK_ADMIN_USE_PROXY=true
MEALTRACK_SIT_API_URL=
MEALTRACK_PROD_API_URL=

# Legacy direct/proxy target. Leave unset when using the environment switcher.
NEXT_PUBLIC_MEALTRACK_API_URL=
MEALTRACK_API_URL=
